class PieChart {
  constructor(x, y, radius) {
    this.x = x;
    this.y = y;
    this.radius = radius;
    this.data = {};
    this.colors = ["#FF6B6B", "#FFB566", "#FFD93D", "#6BCB77", "#4D96FF"]; // Brighter, more vibrant colors
  }

  addData(label, value) {
    this.data[label] = value;
  }

  getTotal() {
    return Object.values(this.data).reduce((sum, value) => sum + value, 0);
  }

  draw() {
    let total = this.getTotal();
    if (total === 0) return;
    
    let lastAngle = 0;
    let i = 0;
    for (let key in this.data) {
      let sliceAngle = (this.data[key] / total) * TWO_PI;
      fill(this.colors[i % this.colors.length]);
      arc(this.x, this.y, this.radius * 2, this.radius * 2, lastAngle, lastAngle + sliceAngle, PIE);
      lastAngle += sliceAngle;
      i++;
    }
  }
}

let pieChart;

function setup() {
  createCanvas(600, 400);
  pieChart = new PieChart(width / 2, height / 2, 150);
  
  pieChart.addData("header", 28);
  pieChart.addData("penalty", 111);
  pieChart.addData("freeKick", 66);
  pieChart.addData("outsideBox", 97);
  pieChart.addData("insideBox", 578);
}

function draw() {
  background(240);
  pieChart.draw();
}
